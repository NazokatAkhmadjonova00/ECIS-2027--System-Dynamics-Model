{UTF-8}
Reprocessable Proportion=
	MIN REPROCESSABLE PROPORTION + ((MODULARITY + INSTITUTIONAL TRUST+TRACEABILITY MATURITY\
		)/3) * (MAX REPROCESSABLE PROPORTION
	 - MIN REPROCESSABLE PROPORTION)
	~	Dmnl
	~		|

collection rate=
	"In-Use devices"/"In-use Time"
	~	devices/Month
	~		|

DEMAND=
	500+STEP( DemandSt-500 , 5)
	~	devices/Month
	~		|

DemandSt=
	500
	~	
	~		|

InstitutionalTrust=
	0.97
	~	
	~		|

TraceabilityMaturity=
	0.91
	~	
	~		|

TRACEABILITY MATURITY=
	0.05+STEP(TraceabilityMaturity -0.05  , 5)
	~	Dmnl
	~		|

INSTITUTIONAL TRUST=
	0.52+STEP( InstitutionalTrust-0.52, 5 )
	~	Dmnl
	~		|

MAX RECYCLABLE PROPORTION=
	0.91
	~	Dmnl
	~		|

MAX REPROCESSABLE PROPORTION=
	0.52
	~	Dmnl
	~		|

MIN RECYCLABLE PROPORTION=
	0.51
	~	Dmnl
	~		|

"Base In-domain Reuse Rate"=
	0.65*0.6*DECONTAMINATION COMPLIANCE RATE
	~	Dmnl
	~		|

MIN REPROCESSABLE PROPORTION=
	0
	~	Dmnl
	~		|

reprocessing flow=
	Reprocessable Proportion*Returned Devices Output Rate
	~	devices/Month
	~		|

raw material input rate=
	MAX(0, DEMAND - recycled material input rate - release to market rate)
	~	devices/Month
	~		|

Recyclable Proportion=
	MIN RECYCLABLE PROPORTION + MODULARITY * (MAX RECYCLABLE PROPORTION - MIN RECYCLABLE PROPORTION\
		)
	~	Dmnl
	~		|

"INCINERATION SHARE OF NON-RECYCLABLE"=
	0.57
	~	Dmnl
	~		|

"Reusable In-domain"=
	TRACEABILITY MATURITY*"Base In-domain Reuse Rate"
	~	Dmnl
	~		|

recycling rate=
	Dissasembly Output Rate * Recyclable Proportion
	~	kg/Month
	~		|

DECONTAMINATION COMPLIANCE RATE=
	0.6
	~	Dmnl
	~		|

device disassembly rate=
	Returned Devices Output Rate*(1-Reprocessable Proportion)
	~	devices/Month
	~		|

Device Failure Rate=
	BASE FAILURE RATE * (1 - TRACEABILITY MATURITY * 0.3)* (1 + (1 - REGULATORY STRINGENCY LEVEL\
		) * 0.5)
	~	Dmnl
	~		|

Removal Time=
	0.5
	~	Month
	~		|

removal rate=
	(Device Failure Rate+CERTIFICATE EXPIRATION RATE)*"In-Use devices"/Removal Time
	~	devices/Month
	~		|

Dissasembly Output Rate=
	Disassembly/Dissasembly Time
	~	kg/Month
	~		|

WASTE SPLIT CHECK=
	incineration rate+landfill rate+recycling rate
	~	kg/Month
	~		~	:SUPPLEMENTARY 
	|

Hospital Infections Rate=
	(Device Failure Rate*market release rate+ Reprocessing Risk Factor * release to market rate\
		)/adoption rate
	~	Dmnl
	~		~	:SUPPLEMENTARY 
	|

Returned Devices Output Rate=
	"Returned/ Collected Devices"/Collection Time
	~	devices/Month
	~		|

Reusable in Other Domain=
	1-"Reusable In-domain"
	~	Dmnl
	~		|

incineration rate=
	Dissasembly Output Rate * (1 - Recyclable Proportion) * "INCINERATION SHARE OF NON-RECYCLABLE"
	~	kg/Month
	~		|

landfill rate=
	Dissasembly Output Rate * (1 - Recyclable Proportion) * (1 - "INCINERATION SHARE OF NON-RECYCLABLE"\
		)
	~	kg/Month
	~		|

release to market rate=
	Reprocessed devices/Reprocessing Time*INSTITUTIONAL TRUST
	~	devices/Month
	~		|

adoption rate=
	Marketed Devices/Release Time
	~	devices/Month
	~		|

market release rate=
	Manufactured Devices/Production Time
	~	devices/Month
	~		|

REPROCESSING CYCLES=
	1
	~	Dmnl
	~		|

Reprocessing Risk Factor=
	BASE REPROCESSING RISK *REPROCESSING CYCLES*(1- REGULATORY STRINGENCY LEVEL*0.7)*(1-\
		TRACEABILITY MATURITY*0.3)
	~	Dmnl
	~		|

"Single-Use Cost"=
	raw material input rate * UNIT COST PER DEVICE NEW 
	                + UNIT DISPOSAL COST * (incineration rate + landfill rate)
	~	Euro/Month
	~		|

recycled material input rate=
	"recycled material reused in-domain"/AVERAGE MATERIAL INTENSITY
	~	devices/Month
	~		|

Circular Cost=
	recycled material input rate * COST OF RECYCLED MATERIAL * AVERAGE MATERIAL INTENSITY
	              + release to market rate * UNIT COST REPROCESSING
	              + ("recycled material reused in-domain"+ recycled material moving to other domains rate\
		)* COST OF RECYCLED MATERIAL
	~	Euro/Month
	~		|

"recycled material reused in-domain"=
	Material recycled/Material Recycling Time*"Reusable In-domain"
	~	kg/Month
	~		|

UNIT COST PER DEVICE NEW=
	170
	~	Euro/devices
	~		|

COST OF RECYCLED MATERIAL=
	2.325
	~	Euro/kg
	~		|

Cost Resilience=
	(Cost Saving / "Single-Use Cost")
	                  * Material Price Stability 
	                  * (1 - Supply Distruption Risk)
	~	Dmnl
	~		~	:SUPPLEMENTARY 
	|

UNIT COST REPROCESSING=
	16
	~	Euro/devices
	~		|

Cost Saving=
	"Single-Use Cost"-Circular Cost
	~	Euro/Month
	~		|

UNIT DISPOSAL COST=
	2.038
	~	Euro/kg
	~		|

"In-Use devices"= INTEG (
	adoption rate-collection rate-removal rate,
		2674.8)
	~	devices
	~		|

"Waste Generated (per Month)"=
	incineration rate+landfill rate
	~	kg/Month
	~		~	:SUPPLEMENTARY 
	|

Material recycled= INTEG (
	recycling rate-"recycled material reused in-domain"-recycled material moving to other domains rate\
		,
		57.4)
	~	kg
	~		|

Dissasembly Time=
	1
	~	Month
	~		|

recycled material moving to other domains rate=
	Reusable in Other Domain*Material recycled/Material Recycling Time
	~	kg/Month
	~		|

Landfill= INTEG (
	landfill rate,
		1)
	~	kg
	~		|

REGULATORY STRINGENCY LEVEL=
	0.6
	~	Dmnl
	~		|

Material Price Stability=
	1 - (1 - TRACEABILITY MATURITY) * 0.2
	~	Dmnl
	~		|

BASE FAILURE RATE=
	0.018
	~	Dmnl
	~		|

BASE REPROCESSING RISK=
	0.206
	~	Dmnl
	~		|

CERTIFICATE EXPIRATION RATE=
	0.0417
	~	Dmnl
	~		|

Material Recycling Time=
	1
	~	Month
	~		|

MODULARITY=
	0.6
	~	Dmnl
	~		|

Supply Distruption Risk=
	MAX(0, 1 - REGULATORY STRINGENCY LEVEL * 0.5 
	                              - INSTITUTIONAL TRUST * 0.5)
	~	Dmnl
	~		|

"Waste Generated (Total)"=
	Incineration+Landfill
	~	kg
	~		~	:SUPPLEMENTARY 
	|

Release Time=
	1
	~	Month
	~		|

"In-use Time"=
	16.4
	~	Month
	~		|

"Returned/ Collected Devices"= INTEG (
	collection rate-device disassembly rate-reprocessing flow,
		163.1)
	~	devices
	~		|

Production Time=
	4.5
	~	Month
	~		|

Reprocessing Time=
	1
	~	Month
	~		|

Manufactured Devices= INTEG (
	raw material input rate+recycled material input rate-market release rate,
		2101.2)
	~	devices
	~		|

Disassembly= INTEG (
	disassembly rate-landfill rate-incineration rate-recycling rate,
		76.6)
	~	kg
	~		|

disassembly rate=device disassembly rate*AVERAGE MATERIAL INTENSITY
	~	kg/Month
	~		|

Incineration= INTEG (incineration rate,
		1)
	~	kg
	~		|

AVERAGE MATERIAL INTENSITY=
	0.589
	~	kg/devices
	~		|

Collection Time=
	1
	~	Month
	~		|

Marketed Devices= INTEG (
	market release rate+release to market rate-adoption rate,
		500)
	~	devices
	~		|

Reprocessed devices= INTEG (
	reprocessing flow-release to market rate,
		63.6)
	~	devices
	~		|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 60
	~	Month
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Month
	~	The initial time for the simulation.
	|

SAVEPER  = 1
	~	Month [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 0.03125
	~	Month [0,?]
	~	The time step for the simulation.
	|

